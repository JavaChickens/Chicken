# Version: 1.0.0

#Drizzle/ACTIVATE

# =============================================================================
# VULTURE - NETWORKING CORE
# =============================================================================

@[VultureCore]
[VULTURE.CORE]
name="Vulture"
version="1.0.0"
type="networking"
description="Network access tool for DevRC with fetch, download, and API capabilities"

# Vulture initialization
vulture={} try (networking)
vulture.initialized=true
vulture.timeout=30
vulture.retries=3
vulture.user_agent="Vulture-DevRC/1.0"

# =============================================================================
# VULTURE NETWORKING CONFIGURATION
# =============================================================================

@[VultureNetworking]
[VULTURE.NETWORKING]
# Network priority configuration
vulture.networking.priority="" is STR
vulture.networking.protocol="https"
vulture.networking.port=443
vulture.networking.ssl_verify=true
vulture.networking.follow_redirects=true
vulture.networking.max_redirects=5

# Network methods
vulture.networking.methods=["GET","POST","PUT","DELETE","PATCH"]
vulture.networking.default_method="GET"

# Headers configuration
vulture.networking.headers={
  "User-Agent": "Vulture-DevRC/1.0",
  "Accept": "*/*",
  "Accept-Encoding": "gzip, deflate",
  "Connection": "keep-alive"
}

# =============================================================================
# VULTURE FETCH OPERATIONS
# =============================================================================

@[VultureFetch]
[VULTURE.FETCH]
# Fetch function with priority
vulture.fetch=function (
  # Get priority link
  link=vulture.networking.priority is STR
  
  # Validate URL
  if (link) is STR try (
    # Parse URL components
    url.protocol=vulture.networking.protocol
    url.host=link -extract -domain
    url.path=link -extract -path
    url.query=link -extract -query
    
    # Build request
    request={
      method: "GET",
      url: link,
      headers: vulture.networking.headers,
      timeout: vulture.timeout
    }
    
    # Execute fetch
    -cmdbin -cmdline -rline is STR "curl" -o "wget" with link
    response=get link -out table[content] with vulture.networking
    
    # Process response
    if (response.status) is numerics "200" try (
      response.body -out is STR in table[content]
      response.success=true
      return {response.body, response.success}
    ) else catch {
      err in STR "Fetch failed" with response.status
      response.success=false
      return {err, response.success}
    }
  ) else catch {
    err in STR "Invalid URL" with link
    return err
  }
)

# Fetch with custom options
vulture.fetch.custom=function (
  link=vulture.networking.priority
  method=vulture.networking.default_method
  headers=vulture.networking.headers
  body=content[null]
  
  # Execute custom fetch
  -cmdbin -cmdline with method, link, headers
  response=get link -out table[content]
  return response
)

# =============================================================================
# VULTURE DOWNLOAD OPERATIONS
# =============================================================================

@[VultureDownload]
[VULTURE.DOWNLOAD]
# Download file from URL
vulture.download=function (
  link=vulture.networking.priority is STR
  output_path="./" is STR
  filename="" is STR
  
  # Generate filename if not provided
  if (filename) is "" try (
    filename=link -extract -filename
  )
  
  # Full output path
  output=output_path + filename
  
  # Download operation
  -cmdbin -cmdline -rline is STR "curl -O" with link -out output
  -cmdbin -cmdline -rline is STR "wget -O" with output, link
  
  # Verify download
  if (output) -exists try (
    download.success=true
    download.path=output
    download.size=output -get -filesize
    return {download.success, download.path, download.size}
  ) else catch {
    err in STR "Download failed" with link
    return err
  }
)

# Batch download
vulture.download.batch=function (
  links=[] in table[content]
  output_path="./"
  
  downloaded=[]
  for (link) in links try (
    result=vulture.download(link, output_path)
    downloaded -add result
  )
  return downloaded
)

# =============================================================================
# VULTURE API OPERATIONS
# =============================================================================

@[VultureAPI]
[VULTURE.API]
# API request function
vulture.api.request=function (
  endpoint=vulture.networking.priority
  method="GET"
  data=content[null]
  headers=vulture.networking.headers
  
  # Build API request
  api.url=endpoint
  api.method=method
  api.data=data
  api.headers=headers
  
  # Execute API call
  if (method) is "GET" try (
    response=vulture.fetch(endpoint)
  ) else if (method) is "POST" try (
    -cmdbin -cmdline -rline "curl -X POST" with endpoint, data
    response=get endpoint -out table[content]
  ) else if (method) is "PUT" try (
    -cmdbin -cmdline -rline "curl -X PUT" with endpoint, data
    response=get endpoint -out table[content]
  ) else if (method) is "DELETE" try (
    -cmdbin -cmdline -rline "curl -X DELETE" with endpoint
    response=get endpoint -out table[content]
  )
  
  return response
)

# API with authentication
vulture.api.auth=function (
  endpoint=vulture.networking.priority
  token="" is STR
  auth_type="Bearer"
  
  # Add authentication header
  headers=vulture.networking.headers
  headers["Authorization"]=auth_type + " " + token
  
  # Execute authenticated request
  response=vulture.api.request(endpoint, "GET", content[null], headers)
  return response
)
